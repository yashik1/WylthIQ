# ---------------------------------------------------------------------------
# WylthIQ configuration
#
# The app runs with NONE of these set: SEC EDGAR needs no key, so fundamentals,
# scores, filings and the screener all work out of the box. The keys below add
# price charts and news, and are all free.
#
# Copy to .env.local and fill in what you want.
# ---------------------------------------------------------------------------

# --- Database (required for the screener and precomputed scores) ------------
# Provision Postgres on Railway (railway.com -> New -> Database -> PostgreSQL)
# and paste its connection string here.
DATABASE_URL=

# --- SEC EDGAR (no key, but identify yourself) ------------------------------
# The SEC requires a User-Agent with a contact address and blocks requests
# without one. Put your own email here.
SEC_USER_AGENT="WylthIQ (your-name) your-email@example.com"

# --- Twelve Data: price charts (free) ---------------------------------------
# Free key at twelvedata.com/register — an email signup, no brokerage account
# and no identity check. Covers every interval the charts offer: 1min, 5min,
# 15min, 1h, 1day and 1week.
#
# Free plan limits: 800 credits/day and 8 credits/minute (one chart view costs
# one credit). Intraday history at 1-minute resolution starts 2020-02-10.
# Without this, everything works except the price charts and live quotes.
TWELVEDATA_API_KEY=
# Free-plan prices carry a short delay, so quotes are labelled "15-min delayed".
# Set to true only if you are on a paid real-time plan.
TWELVEDATA_REALTIME=false

# --- Tiingo: price fallback (free, optional but recommended) ----------------
# Free key at https://www.tiingo.com/account/api/token
#
# Used automatically when Twelve Data hits its 8-requests-per-minute ceiling.
# Tiingo counts usage per hour and per month rather than per minute, so the two
# limits rarely bite at the same time. Covers daily and weekly history with 30+
# years of depth; fine-grained intraday stays with Twelve Data.
TIINGO_API_KEY=

# --- Finnhub: news, logos, peers, analyst ratings, quote fallback (free) -----
# Free key at finnhub.io/register — 60 requests/minute.
# Note: Finnhub's free tier does NOT include price candles (it returns 403),
# which is why Twelve Data supplies chart data. Its /quote endpoint IS free
# though, at 60 requests/minute, so it also acts as the quote fallback.
#
# It also serves the analyst rating distribution shown under "What the market
# expects". Price targets are NOT on the free tier, so that panel shows who
# said what without a target. Without this key the panel simply does not
# appear, which is the correct behaviour rather than a degraded one — the free
# tier is licensed for PERSONAL, NON-COMMERCIAL use, so anything charging for
# a product containing it needs a commercial licence first.
FINNHUB_API_KEY=

# --- Alpha Vantage: fundamentals outside SEC coverage (free, optional) ------
# Free key at https://www.alphavantage.co/support/#api-key
#
# Consulted only when you open a company SEC EDGAR does not cover — a TSX-only
# listing such as ATZ (Aritzia), or an LSE or Frankfurt name. Never used for the
# nightly universe pass: the free allowance is 25 requests a day, which suits an
# occasional lookup but would take weeks to cover 500+ companies.
#
# Figures come back in the company's own currency (CAD for a Canadian filer).
# Ratios stay valid; absolute amounts are not comparable with a US company's.
ALPHAVANTAGE_API_KEY=

# --- Yahoo Finance: widest free coverage (OPT-IN — read this first) ---------
# Set to "true" to enable. It is off by default deliberately.
#
# Yahoo has published no finance API since 2017; these are internal endpoints
# behind the website. Their terms prohibit automated access and republishing,
# and the data is described as personal use only. For private research the
# practical risk is low. For a public, deployed product it is meaningfully
# higher — that is your call to make, which is why nothing here turns it on for
# you.
#
# When enabled it is the only free source covering non-US exchanges: TSX, LSE,
# and the rest, for both prices and fundamentals. Use exchange suffixes —
# ATZ.TO for Toronto, TSCO.L for London.
#
# Being undocumented, it can change or break without notice, so it sits last in
# the chain and every call fails soft.
ENABLE_YAHOO_FALLBACK=false

# --- EODHD: worldwide coverage (paid, optional) -----------------------------
# Setting this ONE key switches the entire app from the free US/Canada stack to
# worldwide coverage: 60+ exchanges, 150,000+ tickers, global fundamentals.
# No other change is needed.
#
# ALL-IN-ONE is ~$100/mo (eodhd.com/pricing). Be aware that its true real-time
# feed covers US equities, forex and crypto only; other world exchanges are
# 15-20 minutes delayed because of per-exchange licensing.
EODHD_API_KEY=

# --- Scheduled jobs and internal diagnostics ---------------------------------
# REQUIRED in production. Any long random string; generate with:
#   openssl rand -base64 32
#
# Every /api/cron/* route refuses to run without it — 503, no work done. That
# is deliberate: those jobs spend SEC, Twelve Data and Finnhub rate limits and
# write to the database, so an unset secret used to mean anybody who found the
# URL could trigger a full ingestion. Send it as 'Authorization: Bearer <secret>'.
CRON_SECRET=

# Optional. Gates the detailed /api/health payload — the database host, table
# presence, row counts, provider status, running commit. Without it anonymous
# callers get only {"status":"ok"} and CRON_SECRET is accepted instead, so this
# is only needed if you want the two separated.
HEALTH_SECRET=

# ---------------------------------------------------------------- accounts
# Signs session cookies. Without it nobody can sign in, and a weak one lets
# anyone mint their own session. Generate with: openssl rand -base64 32
AUTH_SECRET=

# The site's own origin, used to build password-reset links. Must match where
# the app is actually served or the emailed link points at the wrong host.
AUTH_URL=https://your-app.up.railway.app

# ------------------------------------------------------------------- email
# Password reset needs to send mail. Without both of these the reset flow
# still works but writes the link to the server log instead of sending it —
# fine locally, not fine in production.
RESEND_API_KEY=
EMAIL_FROM=WylthIQ <noreply@yourdomain.com>

# ---------------------------------------------------------------- payments
# Backtesting and the trade journal are the only paid features; everything
# else works signed-out. Without these three the paid pages show a "billing
# is not configured" notice rather than breaking, so a deployment that does
# not want to charge for anything can simply leave them empty.
#
# Secret key: dashboard.stripe.com/apikeys — starts sk_test_ while you are
# testing, sk_live_ once you flip the dashboard out of test mode. The two are
# separate worlds: a price created in test mode does not exist in live mode.
STRIPE_SECRET_KEY=

# The recurring price to sell, NOT the product it belongs to. Stripe shows
# both on the product page and they look alike — the one you want starts
# price_, not prod_.
STRIPE_PRICE_ID=

# The other plans, added when this app grew from one subscription to three.
# All optional: a plan with no price id set simply is not offered, and
# STRIPE_PRICE_ID above still works on its own as Pro monthly, so a deployment
# that sets none of these keeps selling exactly what it sold before.
#
# The tier a customer lands on is resolved from whichever of these their price
# id matches, then stored on their subscription row — so rotating one of these
# later does not retroactively change what an existing subscriber has.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_PLUS_MONTHLY_PRICE_ID=
STRIPE_PRO_PLUS_YEARLY_PRICE_ID=

# Signs the webhook, which is the only thing in this app that grants paid
# access. Without the signature check the endpoint is a public URL that hands
# anyone a subscription by POSTing JSON, so it refuses to run without this.
# Shown once when you create the endpoint at dashboard.stripe.com/webhooks —
# starts whsec_. It is per-endpoint, so the test and live endpoints have
# different ones.
STRIPE_WEBHOOK_SECRET=
